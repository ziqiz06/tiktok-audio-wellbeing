# Participant / raw behavioral data -- never commit (IRB/privacy restricted).
# Everything under data/ (raw DDP/EMA exports, derived CSVs, downloaded
# videos) is ignored except the schema README.
data/*
!data/README.md
*.csv
*.wav
*.mp4

# Pretrained model weights
third_party/ast/pretrained_models/*.pth

# Virtual environment
venvast/
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# macOS
.DS_Store

# Pipeline run logs/state -- not research output, regenerated each run
logs/
PIPELINE_STATUS.txt
